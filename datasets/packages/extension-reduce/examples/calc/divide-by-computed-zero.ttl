# (1 + 2) / (5 - 5)
#
# The other side of the line divide-by-zero.ttl draws.  The action asks
# whether the right operand is the number 0, which is a fact about the
# production it is reducing; it does not evaluate the expression, which is
# somebody else's job -- so this conforms, and what comes out of the fold is
# an AST that divides by zero for whoever evaluates it to answer for.
PREFIX : <http://a.example/calc#>
BASE <http://a.example/expr4>

<#e1> a :Div ; :left <#e2> ; :right <#e3> .
<#e2> a :Add ; :left <#e4> ; :right <#e5> .
<#e3> a :Sub ; :left <#e6> ; :right <#e7> .
<#e4> a :Num ; :value 1 .
<#e5> a :Num ; :value 2 .
<#e6> a :Num ; :value 5 .
<#e7> a :Num ; :value 5 .
