# 10 * ((5 * 45) - 16), where 16 != 10 + 5 + 45: the last number read is not
# the sum of the ones before it.
PREFIX : <http://a.example/calc#>
BASE <http://a.example/expr2>

<#e1> a :Mul ; :left <#e2> ; :right <#e3> .
<#e2> a :Num ; :value 10 .
<#e3> a :Sub ; :left <#e4> ; :right <#e7> .
<#e4> a :Mul ; :left <#e5> ; :right <#e6> .
<#e5> a :Num ; :value  5 .
<#e6> a :Num ; :value 45 .
<#e7> a :Num ; :value 16 .
