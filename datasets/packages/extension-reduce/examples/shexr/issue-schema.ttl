# A ShEx schema, written as RDF: the data the ShExR reader reads.
#
# This is ShExR -- the RDF serialization of ShEx -- so validating it against
# ShExR.shex is validating a schema, and the actions hung on ShExR.shex
# reduce what matched to the ShExJ it means.  Written out, it says:
#
#   PREFIX : <http://a.example/>
#   PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
#
#   <#IssueShape> {
#     :state      [:unassigned :assigned] ;
#     :reportedBy @<#UserShape> ;
#     :reportedOn xsd:dateTime ?
#   }
#
#   <#UserShape> {
#     :name  xsd:string ;
#     :email IRI *
#   }
#
# Every shape it refers to it also declares, which is what lets it validate
# against ShExR.shex as it stands: a reference to a shape declared somewhere
# else is a node with no properties at all, and no ShExR production admits
# that.
PREFIX : <http://a.example/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sx: <http://www.w3.org/ns/shex#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
BASE <http://a.example/>

[] a sx:Schema ;
    sx:shapes (<#IssueShape> <#UserShape>) .

<#IssueShape> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:EachOf ; sx:expressions (
        [ a sx:TripleConstraint ;
            sx:predicate :state ;
            sx:valueExpr [ a sx:NodeConstraint ;
                    sx:values ( :unassigned :assigned ) ] ]
        [ a sx:TripleConstraint ;
            sx:predicate :reportedBy ;
            sx:valueExpr <#UserShape> ]
        [ a sx:TripleConstraint ;
            sx:predicate :reportedOn ;
            sx:valueExpr [ a sx:NodeConstraint ;
                    sx:datatype xsd:dateTime ] ;
            sx:min 0 ;
            sx:max 1 ]
      ) ] ] .

<#UserShape> a sx:ShapeDecl ; sx:shapeExpr [ a sx:Shape ;
    sx:expression [ a sx:EachOf ; sx:expressions (
        [ a sx:TripleConstraint ;
            sx:predicate :name ;
            sx:valueExpr [ a sx:NodeConstraint ;
                    sx:datatype xsd:string ] ]
        [ a sx:TripleConstraint ;
            sx:predicate :email ;
            sx:valueExpr [ a sx:NodeConstraint ;
                    sx:nodeKind sx:iri ] ;
            sx:min 0 ;
            sx:max -1 ]
      ) ] ] .
