{
  "name": "shex-vscode",
  "displayName": "ShEx",
  "description": "ShEx (Shape Expressions) language support: ShExC schemas, Turtle/TriG data, and ShapeMaps, powered by @shexjs/language-server.",
  "version": "1.0.0-alpha.31",
  "private": true,
  "publisher": "shexjs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shexjs/shex.js"
  },
  "main": "./lib/extension.js",
  "activationEvents": [
    "onLanguage:shexc",
    "onLanguage:turtle",
    "onLanguage:shex-shapemap"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shexc",
        "aliases": ["ShExC", "shexc", "ShEx"],
        "extensions": [".shex", ".shexc"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "turtle",
        "aliases": ["Turtle", "turtle", "TriG"],
        "extensions": [".ttl", ".trig", ".turtle"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "shex-shapemap",
        "aliases": ["ShapeMap", "shapemap"],
        "extensions": [".smap", ".shapemap"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "shexc",
        "scopeName": "source.shexc",
        "path": "./syntaxes/shexc.tmLanguage.json"
      },
      {
        "language": "turtle",
        "scopeName": "source.turtle",
        "path": "./syntaxes/turtle.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "shex.validateThisNode",
        "title": "ShEx: Validate this node…"
      },
      {
        "command": "shex.validateAgainstThisShape",
        "title": "ShEx: Validate against this shape…"
      },
      {
        "command": "shex.clearValidationSelection",
        "title": "ShEx: Clear validation selection"
      },
      {
        "command": "shex.validateInteractive",
        "title": "ShEx: Validate (enter a shape map)…"
      },
      {
        "command": "shex.openManifestBrowser",
        "title": "ShEx: Open Manifest Browser"
      },
      {
        "command": "shex.showComposedManifest",
        "title": "ShEx: Show Composed Manifest"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "shex.validateThisNode",
          "when": "editorLangId == turtle",
          "group": "shex@1"
        },
        {
          "command": "shex.validateAgainstThisShape",
          "when": "editorLangId == shexc",
          "group": "shex@1"
        }
      ]
    },
    "configuration": {
      "title": "ShEx",
      "properties": {
        "shex.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the ShEx language server."
        }
      }
    }
  },
  "dependencies": {
    "@shexjs/language-server": "^1.0.0-alpha.31",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "tsc",
    "vscode:prepublish": "tsc"
  }
}
