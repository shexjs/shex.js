{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "module": "none",
    "outDir": "./doc",
    "rootDir": "./src/app",
    "target": "ES2022",
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "alwaysStrict": false,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/app/**/*.ts"]
}
