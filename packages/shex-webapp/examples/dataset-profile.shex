PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# A WebID's data lives in its profile document.  `GRAPH FRAGMENT` follows
# the matched value into the graph its IRI names once the fragment is
# stripped: <https://alice.example/card#me> is described in the graph
# <https://alice.example/card> (doc/datasets.md).
<#ProfileDoc> {
  a [foaf:PersonalProfileDocument] ;
  foaf:primaryTopic GRAPH FRAGMENT @<#Person>
}

<#Person> {
  a [foaf:Person] ;
  foaf:name xsd:string ;
  foaf:knows GRAPH FRAGMENT @<#Person> *
}
