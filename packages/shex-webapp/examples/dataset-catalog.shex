PREFIX ex:  <http://ex.example/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# The <CardCatalog> graph holds metadata about the dataset's other
# contents: which graph came from where, and when to fetch it again.
# `GRAPH <CardCatalog>` says both the ^ex:manages arc and the entry it
# reaches live there (doc/datasets.md).
<#S1> {
  ^ex:manages GRAPH <CardCatalog> @<#catalogEntry> ;
  ex:foo xsd:string
}

<#catalogEntry> {
  ex:manages IRI ;
  ex:source xsd:string ;
  ex:refresh xsd:date
}
