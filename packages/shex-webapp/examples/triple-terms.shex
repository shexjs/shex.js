PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ex:   <http://ex.example/ns#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

# People, asserted the ordinary way.
<#Person> { a [foaf:Person] ; foaf:name xsd:string }

# Provenance: an assertion is a *reifier* -- an ordinary node carrying
# rdf:reifies to a triple term (doc/triple-terms.md).  The <<( ... )>>
# atom constrains the term positionally; @<#Person> on a component walks
# that term's asserted neighborhood, so this Assertion only reifies
# knowings between described Persons.
<#Assertion> {
  rdf:reifies <<( @<#Person> foaf:knows @<#Person> )>> ;
  ex:assertedBy @<#Person> ;
  ex:confidence xsd:decimal ?
}

# Second-order talk needs no second-order quotation: the assertion is a
# node, so a dispute references it.
<#Dispute> {
  ex:disputes @<#Assertion> ;
  ex:isDisputedBy @<#Person> ;
  ex:disputeReason xsd:string ;
  ex:disputedOn xsd:date
}

# Property-graph edge properties: the weight is a property of *this* edge
# -- this reifier -- so it is a plain arc on the focus.  Don't reach out to
# the quoted statement for it: a statement can carry several reifiers (two
# people annotating the same fact), and this edge's weight is none of their
# business.  See <#WellSourced> for when reaching the statement is right.
<#WeightedEdge> {
  rdf:reifies <<( IRI foaf:knows IRI )>> ;
  ex:weight xsd:decimal
}

# Term as focus: a triple term is a term with a neighborhood of its own, so
# ^rdf:reifies reaches the reifiers OF a statement.  Well-sourcedness is a
# property of the *statement*, not of one reifier -- "every attestation of
# this fact names a source" -- so reaching across all of them is exactly
# the point (the mistake <#WeightedEdge> avoids is the strength here).
<#WellSourced> {
  rdf:reifies ( <<( IRI foaf:knows IRI )>>
    AND { ^rdf:reifies @<#Sourced> + } )
}
<#Sourced> { ex:source IRI }

# The purely syntactic reading: a mention, components unexamined.
<#Mention> { rdf:reifies <<( IRI foaf:knows IRI )>> }
