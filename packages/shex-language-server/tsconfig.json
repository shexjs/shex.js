{
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "outDir": "./lib",
        "rootDir": "./src",
        "target": "ES2020",
        "sourceMap": true,
        "declaration": false,
        "skipLibCheck": true,
        "strict": true,
        "resolveJsonModule": true,
        "lib": [
            "ES2021"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "lib"
    ]
}
