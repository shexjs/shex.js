  "description": "Language Server Protocol server for ShEx (ShExC, Turtle/TriG, ShapeMap) built on @shexjs/editor-services",
  "author": {
    "name": "Eric Prud'hommeaux",
    "email": "eric@w3.org",
    "url": "http://www.w3.org/People/Eric/"
  },
  "keywords": [
    "shex",
    "shape expressions",
    "rdf",
    "turtle",
    "lsp",
    "language-server",
    "editor"
