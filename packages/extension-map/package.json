{
  "name": "@shexjs/extension-map",
  "version": "1.0.0-alpha.30",
  "files": [
    "bin",
    "doc",
    "examples",
    "lib",
    "src"
  ],
  "description": "Shape Expressions schema-to-schema mapping extension.",
  "author": {
    "name": "Eric Prud'hommeaux",
    "email": "eric@w3.org",
    "url": "http://www.w3.org/People/Eric/"
  },
  "keywords": [
    "shex",
    "shape expressions",
    "rdf",
    "query",
    "parser"
  ],
  "license": "MIT",
