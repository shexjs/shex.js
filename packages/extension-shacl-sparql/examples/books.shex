PREFIX : <http://a.example/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX shacl-sparql: <http://shex.io/extensions/SHACL-SPARQL/>
:Book {
  :title xsd:string ;
  :isbn xsd:string %shacl-sparql:{
    SELECT ?other ("another book has this ISBN" AS ?message)
    WHERE { ?other :isbn $value . FILTER (?other != $this) }
  %}
}
