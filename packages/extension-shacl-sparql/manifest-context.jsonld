{
  "_comment": "Manifest-entry attributes specific to @shexjs/extension-shacl-sparql, stacked onto ../../doc/webapp-manifest-context.jsonld's core. None exist yet: every entry in its manifest uses core attributes only, the SPARQL living in the schema text. The prefix is reserved regardless, and the scoped `shacl-sparql:parms` term is declared with an empty scope so that the day an attribute is needed (a default endpoint to send queries to, say) it has a defined place to go, the same place every other extension's attributes go. Tentative home: beside the extension's spec, at https://shexspec.github.io/extensions/SHACL-SPARQL/manifest-context.jsonld; here so the sketch resolves offline.",

  "@context": {
    "@version": 1.1,
    "shacl-sparql": "http://shex.io/extensions/SHACL-SPARQL/",

    "shacl-sparql:parms": {
      "@id": "shacl-sparql:parms",
      "@context": {}
    }
  }
}
