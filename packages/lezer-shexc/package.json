{
  "name": "lezer-shexc",
  "version": "0.1.0",
  "description": "Incremental, error-tolerant Lezer grammar for ShEx Compact Syntax (ShExC), with CodeMirror highlighting tags",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "build": "lezer-generator src/shexc.grammar -o src/parser.js",
    "test": "cd ../.. && mocha packages/lezer-shexc/test/*test.js"
  },
  "keywords": [
    "shex",
    "shexc",
    "lezer",
    "codemirror",
    "grammar"
  ],
  "author": {
    "name": "Eric Prud'hommeaux",
    "email": "eric@w3.org",
    "url": "http://www.w3.org/People/Eric/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shexjs/shex.js.git"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.2"
  }
}
