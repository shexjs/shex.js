{
  "_comment": "The scope of @shexjs/neighborhood-wikibase's manifest vocabulary: what a manifest entry may write inside the mapping that manifest-context.jsonld, beside this file, binds as wikibase:parms -- the backend's dbParams, each bare and mapped to an absolute IRI. No prefix is declared here, so this file puts nothing in the scope it is used from and can be bound under a name other than wikibase:parms.",

  "@context": {
    "base": {"@id": "http://shex.io/neighborhoods/wikibase#base", "@type": "@id"},
    "sitematrix": {"@id": "http://shex.io/neighborhoods/wikibase#sitematrix", "@type": "@id"},
    "pages": {"@id": "http://shex.io/neighborhoods/wikibase#pages", "@type": "@id", "@container": "@set"},
    "cacheDir": "http://shex.io/neighborhoods/wikibase#cacheDir"
  }
}
