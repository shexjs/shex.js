# ShExR -> ShExJ, as an overlay on ShExR.shex.
#
# ShExR.shex is the schema for ShEx schemas written as RDF.  It already says,
# production by production, what a ShExR graph may look like -- so a reader
# for it is a reader ShEx can generate, given one action per production
# saying what that production means in ShExJ.
#
# Nothing here is in ShExR.shex, which is a spec document and stays one.
#
# What comes out is ShExJ with every reference expanded in place; feed it to
# ShExUtil.ShExRtoShExJ to fold the repeats back into shape references.

PREFIX sa: <http://shex.io/ns/semact#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
BASE <http://shex.io/examples/shexr-actions>

<#toShExJ> a sa:Overlay ;
  rdfs:comment "read a ShExR graph as ShExJ" ;
  sa:extension <http://shex.io/extensions/Reduce/> ;

  ##### the schema, and the declarations in it

  sa:action
  [ sa:ref <http://www.w3.org/ns/shex#Schema> ;
    sa:code """
      const s = {type: 'Schema'};
      if (has('sx:imports'))   s.imports   = one('sx:imports');
      if (has('sx:startActs')) s.startActs = one('sx:startActs');
      if (has('sx:start'))     s.start     = one('sx:start');
      if (has('sx:shapes'))    s.shapes    = one('sx:shapes');
      return s;
    """ ] ,

  [ sa:ref <http://www.w3.org/ns/shex#ShapeDecl> ;
    sa:code """
      // every node in RDF has a name, so everything gets an id here and
      // ShExUtil.ShExRtoShExJ drops the ones nothing refers to twice
      const d = {type: 'ShapeDecl', id: node};
      if (has('sx:abstract')) d.abstract = str(one('sx:abstract')) === 'true';
      d.shapeExpr = one('sx:shapeExpr');
      return d;
    """ ] ,

  ##### shape expressions

  [ sa:ref <http://www.w3.org/ns/shex#ShapeOr> ;
    sa:code "{type: 'ShapeOr', shapeExprs: one('sx:shapeExprs')}" ] ,

  [ sa:ref <http://www.w3.org/ns/shex#ShapeAnd> ;
    sa:code "{type: 'ShapeAnd', shapeExprs: one('sx:shapeExprs')}" ] ,

  [ sa:ref <http://www.w3.org/ns/shex#ShapeNot> ;
    sa:code "{type: 'ShapeNot', shapeExpr: one('sx:shapeExpr')}" ] ,

  [ sa:ref <http://www.w3.org/ns/shex#ShapeExternal> ;
    sa:code "{type: 'ShapeExternal'}" ] ,

  [ sa:ref <http://www.w3.org/ns/shex#Shape> ;
    sa:code """
      const s = {type: 'Shape'};
      if (has('sx:extends'))    s.extends     = one('sx:extends');
      if (has('sx:closed'))     s.closed      = str(one('sx:closed')) === 'true';
      if (has('sx:extra'))      s.extra       = all('sx:extra');
      if (has('sx:expression')) s.expression  = one('sx:expression');
      if (has('sx:semActs'))    s.semActs     = one('sx:semActs');
      if (has('sx:annotation')) s.annotations = one('sx:annotation');
      return s;
    """ ] ,

  [ sa:ref <http://www.w3.org/ns/shex#NodeConstraint> ;
    sa:code """
      const nc = {type: 'NodeConstraint'};
      if (has('sx:nodeKind')) nc.nodeKind = local(one('sx:nodeKind'));
      if (has('sx:datatype')) nc.datatype = one('sx:datatype');
      ['length', 'minlength', 'maxlength', 'totaldigits', 'fractiondigits']
        .forEach(f => { if (has('sx:' + f)) nc[f] = num(one('sx:' + f)); });
      ['mininclusive', 'minexclusive', 'maxinclusive', 'maxexclusive']
        .forEach(f => { if (has('sx:' + f)) nc[f] = num(one('sx:' + f)); });
      if (has('sx:pattern'))    nc.pattern     = str(one('sx:pattern'));
      if (has('sx:flags'))      nc.flags       = str(one('sx:flags'));
      if (has('sx:values'))     nc.values      = one('sx:values');
      if (has('sx:semActs'))    nc.semActs     = one('sx:semActs');
      if (has('sx:annotation')) nc.annotations = one('sx:annotation');
      return nc;
    """ ] ,

  ##### triple expressions

  [ sa:ref <http://www.w3.org/ns/shex#TripleConstraint> ;
    sa:code """
      const t = {type: 'TripleConstraint', id: node};
      if (has('sx:inverse'))    t.inverse     = str(one('sx:inverse')) === 'true';
      if (has('sx:negated'))    t.negated     = str(one('sx:negated')) === 'true';
      t.predicate = one('sx:predicate');
      if (has('sx:valueExpr'))  t.valueExpr   = one('sx:valueExpr');
      if (has('sx:min'))        t.min         = num(one('sx:min'));
      if (has('sx:max'))        t.max         = num(one('sx:max'));
      if (has('sx:semActs'))    t.semActs     = one('sx:semActs');
      if (has('sx:annotation')) t.annotations = one('sx:annotation');
      return t;
    """ ] ,

  [ sa:ref <http://www.w3.org/ns/shex#EachOf> ;
    sa:code """
      const e = {type: 'EachOf', id: node};
      e.expressions = one('sx:expressions');
      if (has('sx:min'))        e.min         = num(one('sx:min'));
      if (has('sx:max'))        e.max         = num(one('sx:max'));
      if (has('sx:semActs'))    e.semActs     = one('sx:semActs');
      if (has('sx:annotation')) e.annotations = one('sx:annotation');
      return e;
    """ ] ,

  [ sa:ref <http://www.w3.org/ns/shex#OneOf> ;
    sa:code """
      const e = {type: 'OneOf', id: node};
      e.expressions = one('sx:expressions');
      if (has('sx:min'))        e.min         = num(one('sx:min'));
      if (has('sx:max'))        e.max         = num(one('sx:max'));
      if (has('sx:semActs'))    e.semActs     = one('sx:semActs');
      if (has('sx:annotation')) e.annotations = one('sx:annotation');
      return e;
    """ ] ,

  ##### value sets

  [ sa:path "@<http://www.w3.org/ns/shex#Wildcard>/shapeExprs/*/thisShapeExpr::Shape" ;
    sa:code "{type: 'Wildcard'}" ] ,

  [ sa:ref <http://www.w3.org/ns/shex#IriStem> ;
    sa:code "{type: 'IriStem', stem: str(one('sx:stem'))}" ] ,
  [ sa:ref <http://www.w3.org/ns/shex#LiteralStem> ;
    sa:code "{type: 'LiteralStem', stem: str(one('sx:stem'))}" ] ,
  [ sa:ref <http://www.w3.org/ns/shex#LanguageStem> ;
    sa:code "{type: 'LanguageStem', stem: str(one('sx:stem'))}" ] ,
  [ sa:ref <http://www.w3.org/ns/shex#Language> ;
    sa:code "{type: 'Language', languageTag: str(one('sx:languageTag'))}" ] ,

  # a stem range's stem is a string or the Wildcard shape above
  [ sa:ref <http://www.w3.org/ns/shex#IriStemRange> ;
    sa:code """
      const stem = one('sx:stem');
      return {type: 'IriStemRange',
              stem: stem && stem.type === 'Wildcard' ? stem : str(stem),
              exclusions: one('sx:exclusion')};
    """ ] ,
  [ sa:ref <http://www.w3.org/ns/shex#LiteralStemRange> ;
    sa:code """
      const stem = one('sx:stem');
      return {type: 'LiteralStemRange',
              stem: stem && stem.type === 'Wildcard' ? stem : str(stem),
              exclusions: one('sx:exclusion')};
    """ ] ,
  [ sa:ref <http://www.w3.org/ns/shex#LanguageStemRange> ;
    sa:code """
      const stem = one('sx:stem');
      return {type: 'LanguageStemRange',
              stem: stem && stem.type === 'Wildcard' ? stem : str(stem),
              exclusions: one('sx:exclusion')};
    """ ] ,

  ##### semantic actions and annotations, in the schema being read

  [ sa:ref <http://www.w3.org/ns/shex#SemAct> ;
    sa:code """
      const a = {type: 'SemAct', name: one('sx:name')};
      if (has('sx:code')) a.code = str(one('sx:code'));
      return a;
    """ ] ,

  [ sa:ref <http://www.w3.org/ns/shex#Annotation> ;
    sa:code "{type: 'Annotation', predicate: one('sx:predicate'), object: one('sx:object')}" ] ,

  ##### RDF lists
  #
  # A list is a shape that recurses on rdf:rest, so a list reduces the way
  # every other production does: cons the head onto what the tail reduced to.

  [ sa:path "@<http://www.w3.org/ns/shex#IriList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#SemActList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#ShapeDeclList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#valueSetValueList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#AnnotationList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#IriStemExclusionList1Plus>" ; sa:code """
      // an excluded literal is its lexical form in ShExJ, where an excluded
      // IRI or a nested stem is the object it already reduced to
      const head = one('rdf:first');
      return [head && typeof head === 'object' && 'value' in head ? str(head) : head]
        .concat(one('rdf:rest') === nil ? [] : one('rdf:rest'));""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#LiteralStemExclusionList1Plus>" ; sa:code """
      // an excluded literal is its lexical form in ShExJ, where an excluded
      // IRI or a nested stem is the object it already reduced to
      const head = one('rdf:first');
      return [head && typeof head === 'object' && 'value' in head ? str(head) : head]
        .concat(one('rdf:rest') === nil ? [] : one('rdf:rest'));""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#LanguageStemExclusionList1Plus>" ; sa:code """
      // an excluded literal is its lexical form in ShExJ, where an excluded
      // IRI or a nested stem is the object it already reduced to
      const head = one('rdf:first');
      return [head && typeof head === 'object' && 'value' in head ? str(head) : head]
        .concat(one('rdf:rest') === nil ? [] : one('rdf:rest'));""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#tripleExpressionList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#shapeDeclOrExprList1Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest') === nil ? [] : one('rdf:rest'))""" ] ,

  # the 2Plus heads have no rdf:nil case: their tail is always another list
  [ sa:path "@<http://www.w3.org/ns/shex#tripleExpressionList2Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest'))""" ] ,
  [ sa:path "@<http://www.w3.org/ns/shex#shapeDeclOrExprList2Plus>" ; sa:code """
      [one('rdf:first')].concat(one('rdf:rest'))""" ]
.
