@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/NutritionOrder/renaldiet> a fhir:NutritionOrder ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "renaldiet"] ; # id = renaldiet  file name = nutritionorder-example-renaldiet.xml Name= Renal Diet  Description = Nutrition Order Renal Diet Example
#edited by Eric Haas Health eData Inc, EH: use oral Diet element
  fhir:identifier ( [
     fhir:system [
       fhir:v "http://goodhealthhospital.org/nutrition-requests"^^xsd:anyURI ;
       fhir:l <http://goodhealthhospital.org/nutrition-requests>
     ] ;
     fhir:value [ fhir:v "123" ]
  ] ) ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:intent [ fhir:v "order"] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/example> ;
     fhir:reference [ fhir:v "Patient/example" ] ;
     fhir:display [ fhir:v "Peter Chalmers" ]
  ] ; # 
  fhir:encounter [
     fhir:l <http://hl7.org/fhir/Encounter/example> ;
     fhir:reference [ fhir:v "Encounter/example" ] ;
     fhir:display [ fhir:v "Inpatient" ]
  ] ; # 
  fhir:dateTime [ fhir:v "2014-09-17"^^xsd:date] ; # 
  fhir:allergyIntolerance ( [
     fhir:l <http://hl7.org/fhir/AllergyIntolerance/example> ;
     fhir:reference [ fhir:v "AllergyIntolerance/example" ] ; # EH  Show all the elements in this examples for preference, and intolerance
     fhir:display [ fhir:v "Cashew Nuts" ]
  ] ) ; # 
  fhir:foodPreferenceModifier ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/diet"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/diet>
       ] ;
       fhir:code [ fhir:v "dairy-free" ]
     ] )
  ] ) ; # 
  fhir:excludeFoodModifier ( [
     a sct:227493005 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "227493005" ] ;
       fhir:display [ fhir:v "Cashew Nut" ]
     ] )
  ] ) ; # 
  fhir:oralDiet [
     fhir:type ( [
       a sct:437421000124105 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "437421000124105" ] ;
         fhir:display [ fhir:v "Decreased sodium diet (regime/therapy)" ]
       ] [
         fhir:system [
           fhir:v "http://goodhealthhospital.org/diet-type-codes"^^xsd:anyURI ;
           fhir:l <http://goodhealthhospital.org/diet-type-codes>
         ] ;
         fhir:code [ fhir:v "1050" ] ;
         fhir:display [ fhir:v "Renal" ]
       ] ) ;
       fhir:text [ fhir:v "Low Sodium Diet" ]
     ] [
       a sct:437401000124100 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "437401000124100" ] ;
         fhir:display [ fhir:v "Decreased potassium diet (regime/therapy)" ]
       ] )
     ] [
       a sct:437381000124100 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "437381000124100" ] ;
         fhir:display [ fhir:v "Decreased phosphorus diet (regime/therapy)" ]
       ] )
     ] [
       a sct:439061000124104 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "439061000124104" ] ;
         fhir:display [ fhir:v "Fluid restricted diet (regime/therapy)" ]
       ] )
     ] ) ;
     fhir:schedule [
       fhir:timing ( [
         fhir:repeat [
           fhir:bounds [
             a fhir:Period ;
             fhir:start [ fhir:v "2015-02-10"^^xsd:date ]
           ] ;
           fhir:frequency [ fhir:v "3"^^xsd:positiveInteger ] ;
           fhir:period [ fhir:v "1"^^xsd:decimal ] ;
           fhir:periodUnit [ fhir:v "d" ]
         ]
       ] )
     ] ; # EH example of three times a day starting on 2\/10
     fhir:nutrient ( [
       fhir:modifier [
         a sct:60471000 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
             fhir:l <http://snomed.info/sct>
           ] ;
           fhir:code [ fhir:v "60471000" ] ;
           fhir:display [ fhir:v "Sodium compound" ]
         ] )
       ] ; # list nutrients and amounts here
       fhir:amount [
         fhir:value [ fhir:v "2"^^xsd:decimal ] ;
         fhir:unit [ fhir:v "mg/d" ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "mg/d" ]
       ]
     ] [
       fhir:modifier [
         a sct:63793008 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
             fhir:l <http://snomed.info/sct>
           ] ;
           fhir:code [ fhir:v "63793008" ] ;
           fhir:display [ fhir:v "Phosphorus compound" ]
         ] )
       ] ;
       fhir:amount [
         fhir:value [ fhir:v "1"^^xsd:decimal ] ;
         fhir:unit [ fhir:v "mg/d" ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "mg/d" ]
       ]
     ] [
       fhir:modifier [
         a sct:19751002 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
             fhir:l <http://snomed.info/sct>
           ] ;
           fhir:code [ fhir:v "19751002" ] ;
           fhir:display [ fhir:v "Potassium compound" ]
         ] )
       ] ;
       fhir:amount [
         fhir:value [ fhir:v "2"^^xsd:decimal ] ;
         fhir:unit [ fhir:v "mg/d" ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "mg/d" ]
       ]
     ] ) ;
     fhir:instruction [ fhir:v "restrict fluid to 1000 mL/day" ]
  ] . # 

