                                                                       ]
                                                                     )
                                               ];
                            owl:onProperty     fhir:manipulated
                          ];
        rdfs:subClassOf   [ rdf:type         owl:Restriction;
                            owl:cardinality  1;
                            owl:onProperty   fhir:manipulated
                          ] .

