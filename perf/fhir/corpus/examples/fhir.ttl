                            owl:allValuesFrom  [ rdf:type            owl:Class;
                                                 owl:intersectionOf  ( fhir:Reference
                                                                       [ rdf:type           owl:Restriction;
                                                                         owl:allValuesFrom  [ rdf:type     owl:Class;
                                                                                              owl:unionOf  ( fhir:CarePlan fhir:ServiceRequest fhir:MedicationRequest )
                                                                                            ];
                                                                         owl:onProperty     fhir:l
                                                                       ]
                                                                     )
