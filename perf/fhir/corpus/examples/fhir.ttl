        rdfs:subClassOf   [ rdf:type            owl:Restriction;
                            owl:maxCardinality  1;
                            owl:onProperty      fhir:detail
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  fhir:Uri;
                            owl:onProperty     fhir:reference
