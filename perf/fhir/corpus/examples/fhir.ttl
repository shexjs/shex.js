        rdfs:subClassOf   [ rdf:type           owl:Restriction;
                            owl:allValuesFrom  fhir:ImplementationGuide.definition.parameter;
                            owl:onProperty     fhir:parameter
                          ];
        rdfs:subClassOf   [ rdf:type           owl:Restriction;
