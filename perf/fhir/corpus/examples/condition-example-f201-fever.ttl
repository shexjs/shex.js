# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/Condition/f201> a fhir:Condition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "f201"] ; # 
  fhir:identifier ( [
     fhir:value [ fhir:v "12345" ]
  ] ) ; # 
  fhir:clinicalStatus [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/condition-clinical"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/condition-clinical>
       ] ;
       fhir:code [ fhir:v "resolved" ]
     ] )
  ] ; # 
  fhir:verificationStatus [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/condition-ver-status"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/condition-ver-status>
       ] ;
       fhir:code [ fhir:v "confirmed" ]
     ] )
  ] ; # 
  fhir:category ( [
     a sct:55607006 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "55607006" ] ;
       fhir:display [ fhir:v "Problem" ]
     ] [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/condition-category"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/condition-category>
       ] ;
       fhir:code [ fhir:v "problem-list-item" ]
     ] ) # The fever is a mild problem
  ] ) ; # 
  fhir:severity [
     a sct:255604002 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "255604002" ] ;
       fhir:display [ fhir:v "Mild" ]
     ] ) # The fever is mild
  ] ; # 
  fhir:code [
     a sct:386661006 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "386661006" ] ;
       fhir:display [ fhir:v "Fever" ]
     ] ) # The problem is a fever
  ] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/f201> ;
     fhir:reference [ fhir:v "Patient/f201" ] ; # It entails Roel's problem
     fhir:display [ fhir:v "Roel" ]
  ] ; # 
  fhir:encounter [
     fhir:l <http://hl7.org/fhir/Encounter/f201> ;
     fhir:reference [ fhir:v "Encounter/f201" ]
  ] ; # 
  fhir:onset [
     a fhir:DateTime ;
     fhir:v "2013-04-02"^^xsd:date
  ] ; # 
  fhir:abatement [
     a fhir:String ;
     fhir:v "around April 9, 2013"
  ] ; # 
  fhir:recordedDate [ fhir:v "2013-04-04"^^xsd:date] ; # 
  fhir:recorder [
     fhir:l <http://hl7.org/fhir/Practitioner/f201> ;
     fhir:reference [ fhir:v "Practitioner/f201" ]
  ] ; # 
  fhir:asserter [
     fhir:l <http://hl7.org/fhir/Practitioner/f201> ;
     fhir:reference [ fhir:v "Practitioner/f201" ]
  ] ; # 
  fhir:evidence ( [
     fhir:concept [
       a sct:258710007 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "258710007" ] ;
         fhir:display [ fhir:v "degrees C" ]
       ] )
     ] ; # Problem is confirmed by 39 degrees Celsius
     fhir:reference [
       fhir:l <http://hl7.org/fhir/Observation/f202> ;
       fhir:reference [ fhir:v "Observation/f202" ] ;
       fhir:display [ fhir:v "Temperature" ]
     ]
  ] ) . # 

