     fhir:resource [
       fhir:v "http://example.org/LogicalModels/Admission"^^xsd:anyURI ;
       fhir:l <http://example.org/LogicalModels/Admission>
     ] ;
     fhir:supportedInteraction ( [ fhir:v "create" ] [ fhir:v "update" ] ) ;
     fhir:event [
