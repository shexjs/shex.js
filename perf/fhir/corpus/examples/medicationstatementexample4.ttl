@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

# This example is a fully populated example where a patient reports they took this in the past but are not taking it now

<http://hl7.org/fhir/MedicationStatement/example004> a fhir:MedicationStatement ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "example004"] ; # 
  fhir:status [ fhir:v "recorded"] ; # 
  fhir:medication [
     fhir:concept [
       a sct:27658006 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "27658006" ] ;
         fhir:display [ fhir:v "Product containing amoxicillin (medicinal product)" ]
       ] )
     ]
  ] ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/pat1> ;
     fhir:reference [ fhir:v "Patient/pat1" ] ;
     fhir:display [ fhir:v "Donald Duck" ]
  ] ; # 
  fhir:effective [
     a fhir:DateTime ;
     fhir:v "2014-01-23"^^xsd:date
  ] ; # 
  fhir:dateAsserted [ fhir:v "2015-02-22"^^xsd:date] ; # 
  fhir:informationSource ( [
     fhir:l <http://hl7.org/fhir/Patient/pat1> ;
     fhir:reference [ fhir:v "Patient/pat1" ] ;
     fhir:display [ fhir:v "Donald Duck" ]
  ] ) ; # 
  fhir:note ( [
     fhir:text [ fhir:v "Patient indicates they miss the occasional dose" ]
  ] ) ; # 
  fhir:dosage [
     fhir:renderedInstruction [ fhir:v "One capsule three times daily by mouth." ] ;
     fhir:safety [
       fhir:doseLimit ( [
         fhir:value [
           a fhir:Quantity ;
           fhir:value [ fhir:v "3"^^xsd:decimal ] ;
           fhir:unit [ fhir:v "capsules" ] ;
           fhir:system [
             fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
             fhir:l <http://snomed.info/sct>
           ] ;
           fhir:code [ fhir:v "385055001" ]
         ] ;
         fhir:scope [ fhir:v "period" ] ;
         fhir:period [
           fhir:value [ fhir:v "1"^^xsd:decimal ] ;
           fhir:system [
             fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
             fhir:l <http://unitsofmeasure.org>
           ] ;
           fhir:code [ fhir:v "d" ]
         ]
       ] )
     ]
  ] ; # 
  fhir:adherence [
     fhir:code [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://hl7.org/fhir/CodeSystem/medication-statement-adherence"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/CodeSystem/medication-statement-adherence>
         ] ;
         fhir:code [ fhir:v "not-taking" ] ;
         fhir:display [ fhir:v "Not Taking" ]
       ] )
     ] ;
     fhir:reason [
       a sct:266710000 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "266710000" ] ;
         fhir:display [ fhir:v "Drugs not taken/completed" ]
       ] )
     ]
  ] . # 

<http://hl7.org/fhir/Patient/pat1> a fhir:Patient .

