     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem substance-measurement-type</b></p><a name=\"substance-measurement-type\"> </a><a name=\"hcsubstance-measurement-type\"> </a><p>This case-sensitive code system <code>http://hl7.org/fhir/substance-measurement-type</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">ic50<a name=\"substance-measurement-type-ic50\"> </a></td><td>IC50</td><td>Half maximal inhibitory concentration.</td></tr><tr><td style=\"white-space:nowrap\">ec50<a name=\"substance-measurement-type-ec50\"> </a></td><td>EC50</td><td>Half maximal effective concentration.</td></tr><tr><td style=\"white-space:nowrap\">kd<a name=\"substance-measurement-type-kd\"> </a></td><td>Kd</td><td>Equilibrium dissociation constant.</td></tr><tr><td style=\"white-space:nowrap\">ki<a name=\"substance-measurement-type-ki\"> </a></td><td>Ki</td><td>Inhibition constant.</td></tr><tr><td style=\"white-space:nowrap\">km<a name=\"substance-measurement-type-km\"> </a></td><td>Km</td><td>Michaelis constant.</td></tr><tr><td style=\"white-space:nowrap\">kon<a name=\"substance-measurement-type-kon\"> </a></td><td>Kon</td><td>Association rate constant.</td></tr><tr><td style=\"white-space:nowrap\">koff<a name=\"substance-measurement-type-koff\"> </a></td><td>Koff</td><td>Dissociation rate constant.</td></tr><tr><td style=\"white-space:nowrap\">mole-ratio<a name=\"substance-measurement-type-mole-ratio\"> </a></td><td>Mole ratio</td><td>Ratio expressed in moles.</td></tr><tr><td style=\"white-space:nowrap\">weight-ratio<a name=\"substance-measurement-type-weight-ratio\"> </a></td><td>Weight ratio</td><td>Ratio expressed by weight (mass).</td></tr></table></div>"^^rdf:XMLLiteral ]
