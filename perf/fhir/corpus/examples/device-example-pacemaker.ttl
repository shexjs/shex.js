@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/Device/example-pacemaker> a fhir:Device ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "example-pacemaker"] ; # 
  fhir:identifier ( [
     fhir:system [
       fhir:v "http://acme.com/devices/pacemakers/octane/serial"^^xsd:anyURI ;
       fhir:l <http://acme.com/devices/pacemakers/octane/serial>
     ] ;
     fhir:value [ fhir:v "1234-5678-90AB-CDEF" ]
  ] ) ; # 
  fhir:manufacturer [ fhir:v "Acme Devices, Inc"] ; # 
  fhir:lotNumber [ fhir:v "1234-5678"] ; # 
  fhir:name ( [
     fhir:value [ fhir:v "PM/Octane 2014" ] ;
     fhir:type [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://hl7.org/fhir/device-nametype"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/device-nametype>
         ] ;
         fhir:code [ fhir:v "user-friendly-name" ]
       ] )
     ]
  ] ) ; # 
  fhir:type ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://acme.com/devices"^^xsd:anyURI ;
         fhir:l <http://acme.com/devices>
       ] ;
       fhir:code [ fhir:v "octane2014" ] ;
       fhir:display [ fhir:v "Performance pace maker for high octane patients" ]
     ] )
  ] ) ; # 
  fhir:contact ( [
     fhir:system [ fhir:v "phone" ] ;
     fhir:value [ fhir:v "ext 4352" ]
  ] ) . # <association>
