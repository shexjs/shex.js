<http://hl7.org/fhir/ArtifactAssessment/risk-of-bias-example> a fhir:ArtifactAssessment ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "risk-of-bias-example"] ; # 
  fhir:identifier ( [
     fhir:type [
       fhir:text [ fhir:v "FEvIR Object Identifier" ]
     ] ;
     fhir:system [
       fhir:v "https://fevir.net"^^xsd:anyURI ;
       fhir:l <https://fevir.net>
     ] ;
     fhir:value [ fhir:v "27751" ] ;
     fhir:assigner [
       fhir:display [ fhir:v "Computable Publishing LLC" ]
     ]
  ] ) ; # 
  fhir:artifact [
     a fhir:Canonical ;
     fhir:v "http://fevir.net/resources/Evidence/7637"^^xsd:anyURI ;
     fhir:l <http://fevir.net/resources/Evidence/7637>
  ] ; # 
  fhir:date [ fhir:v "2021-11-02T14:31:30.239Z"^^xsd:dateTime] ; # 
  fhir:copyright [ fhir:v "https://creativecommons.org/licenses/by-nc-sa/4.0/"] ; # 
  fhir:lastReviewDate [ fhir:v "2021-08-11"^^xsd:date] ; # 
  fhir:content ( [
     fhir:type [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/certainty-type"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/certainty-type>
         ] ;
         fhir:version [ fhir:v "6.0.0" ] ;
         fhir:code [ fhir:v "RiskOfBias" ] ;
         fhir:display [ fhir:v "Risk of bias" ] ;
         fhir:userSelected [ fhir:v true ]
       ] )
     ] ;
     fhir:classifier ( [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
         ] ;
         fhir:version [ fhir:v "6.0.0" ] ;
         fhir:code [ fhir:v "extremely-serious-concern" ] ;
         fhir:display [ fhir:v "extremely serious concern" ] ;
         fhir:userSelected [ fhir:v true ]
       ] )
     ] ) ;
     fhir:author ( [
       fhir:display [ fhir:v "COVID-19 Knowledge Accelerator Evidence 7637 Authors (Brian S. Alper, Harold Lehmann, Ahmad Sofi-Mahmudi, Joanne Dehnbostel, Ilkka Kunnamo)" ]
     ] ) ;
     fhir:freeToShare [ fhir:v true ] ;
     fhir:component ( [
       fhir:summary [ fhir:v "Inclusion of suspected COVID-19 in 1 of 3 trials may introduce selection bias, but the impact appears limited." ] ;
       fhir:type [
         fhir:text [ fhir:v "Selection Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "no-concern" ] ;
           fhir:display [ fhir:v "no serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Muhammad Afzal" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Selection Bias = A bias resulting from methods used to select subjects or data, factors that influence initial study participation, or differences between the study sample and the population of interest" ]
       ] )
     ] [
       fhir:summary [ fhir:v "The study design used response-adaptive randomization in which group assignment ratios could be modified during the trial on the basis of response-adaptive interim analyses to favor the assignment of patients to the treatment group showing greater benefit. The confounding by time (imbalanced randomization with time period) is not adequately reported to determine the potential influence on results or adequacy of adjusted analyses." ] ;
       fhir:type [
         fhir:text [ fhir:v "Confounding Covariate Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "serious-concern" ] ;
           fhir:display [ fhir:v "serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Ilkka Kunnamo" ]
       ] [
         fhir:display [ fhir:v "Alfonso Iorio" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Harold Lehmann" ]
       ] [
         fhir:display [ fhir:v "Kenneth Wilkins" ]
       ] [
         fhir:display [ fhir:v "clarifying explanation reviewed by Janice Tufte" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Confounding Covariate Bias = A situation in which the effect or association between an exposure and outcome is distorted by another variable. For confounding covariate bias to occur the distorting variable must be (1) associated with the exposure and the outcome, (2) not in the causal pathway between exposure and outcome, and (3) unequally distributed between the groups being compared." ]
       ] [
         fhir:summary [ fhir:v "ATTACC implemented response-adaptive randomization on December 15, 2020, which led to imbalanced randomization. No data reported to determine if intervention-specific outcome rates were similar or different before and after December 15, 2020 in the ATTACC cohort." ]
       ] [
         fhir:summary [ fhir:v "Insufficient details reported to judge whether there is an imbalance in outcomes related to the adaptive randomization which in turn could be used to judge the validity of adjustment methods in the statistical model for this concern and the appropriateness of any sensitivity analyses." ]
       ] [
         fhir:summary [ fhir:v "Response-adaptive randomization led to imbalanced randomization." ] ;
         fhir:type [
           fhir:text [ fhir:v "Allocation Bias" ]
         ] ;
         fhir:classifier ( [
           fhir:text [ fhir:v "Adaptive randomization is not a concern by itself, only if it results in a confounding difference." ]
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] [
           fhir:display [ fhir:v "Joanne Dehnbostel" ]
         ] [
           fhir:display [ fhir:v "Harold Lehmann" ]
         ] [
           fhir:display [ fhir:v "Kenneth Wilkins" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "Definition of Allocation Bias = A confounding covariate bias resulting from methods for assignment of the independent variable by the investigator to evaluate a response or outcome." ]
         ] [
           fhir:summary [ fhir:v "ATTACC implemented response-adaptive randomization on December 15, 2020, which led to imbalanced randomization." ]
         ] )
       ] [
         fhir:summary [ fhir:v "There is an unequal distribution of calendar time between the groups being compared." ] ;
         fhir:type [
           fhir:text [ fhir:v "Confounding difference" ]
         ] ;
         fhir:classifier ( [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
             ] ;
             fhir:version [ fhir:v "6.0.0" ] ;
             fhir:code [ fhir:v "serious-concern" ] ;
             fhir:display [ fhir:v "serious concern" ] ;
             fhir:userSelected [ fhir:v true ]
           ] )
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] [
           fhir:display [ fhir:v "Joanne Dehnbostel" ]
         ] [
           fhir:display [ fhir:v "Harold Lehmann" ]
         ] [
           fhir:display [ fhir:v "Kenneth Wilkins" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "Definition of Confounding difference = A confounding covariate bias in which the unequal distribution of a potentially distorting variable is recognized." ]
         ] [
           fhir:summary [ fhir:v "Incomplete reporting limits the determination of the potential degree of influence of calendar time." ]
         ] [
           fhir:summary [ fhir:v "There is evidence of potential for calendar time to influence the results: In an observational study of 18,508 adults with laboratory-confirmed, COVID-19 associated hospitalization 'The percentage of hospitalized patients admitted to the ICU decreased from 37.8% in March to 20.5% in December' (Ann Intern Med 2021 Aug 10 https://www.acpjournals.org/doi/10.7326/M21-1991)." ]
         ] )
       ] )
     ] [
       fhir:summary [ fhir:v "Awareness of treatment assignment may reduce clinical decision to initiate some types of \"organ support\" in patients with higher risk of major bleeding." ] ;
       fhir:type [
         fhir:text [ fhir:v "Performance Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "very-serious-concern" ] ;
           fhir:display [ fhir:v "very serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Harold Lehmann" ]
       ] [
         fhir:display [ fhir:v "Muhammad Afzal" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Performance Bias = A bias resulting from differences between the received exposure and the intended exposure." ]
       ] [
         fhir:summary [ fhir:v "Lack of blinding may explain reported differences in the primary outcome." ] ;
         fhir:type [
           fhir:text [ fhir:v "Inadequate blinding of intervention deliverers" ]
         ] ;
         fhir:classifier ( [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
             ] ;
             fhir:version [ fhir:v "6.0.0" ] ;
             fhir:code [ fhir:v "very-serious-concern" ] ;
             fhir:display [ fhir:v "very serious concern" ] ;
             fhir:userSelected [ fhir:v true ]
           ] )
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] [
           fhir:display [ fhir:v "clarifying explanation reviewed by Janice Tufte" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "The absolute difference in survival without intubation was 1%, so 3% of the 4% absolute difference in the primary outcome can be considered \"organ support without intubation\"." ]
         ] [
           fhir:summary [ fhir:v "The specific \"organ support without intubation\" was not reported. The methods for one of the included trials stated \"Organ Support is defined as receipt of invasive or non-invasive mechanical ventilation, high flow nasal oxygen, vasopressor therapy, or ECMO support\"" ]
         ] [
           fhir:summary [ fhir:v "Awareness of treatment assignment may reduce clinical decision to initiate \"organ support without intubation\" in patients with higher risk of major bleeding." ]
         ] [
           fhir:summary [ fhir:v "Definition of Inadequate blinding of intervention deliverers = A performance bias due to awareness of the allocated intervention by individuals providing or delivering the intervention." ]
         ] )
       ] [
         fhir:summary [ fhir:v "Crossover to other intervention in 20%" ] ;
         fhir:type [
           fhir:text [ fhir:v "Deviation from study intervention protocol" ]
         ] ;
         fhir:classifier ( [
           fhir:text [ fhir:v "degree of concern unclear" ]
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Surbhi Shah" ]
         ] [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "Therapeutic dose anticoagulation (in the first 24-48 hours following randomization) was reported in 79.6% of the therapeutic arm and 0.9% of the usual care arm. (Table S3)" ]
         ] [
           fhir:summary [ fhir:v "Definition of Deviation from study intervention protocol = A performance bias in which the intervention received differs from the intervention specified in the study protocol." ]
         ] )
       ] [
         fhir:summary [ fhir:v "We discussed whether they may be a bias related to limited adherence to anticoagulation. Because this was an inpatient population, we did not expect adherence problems that are more common with outpatient thromboprophylaxis." ] ;
         fhir:type [
           fhir:text [ fhir:v "Nonadherence of implementation" ]
         ] ;
         fhir:classifier ( [
           fhir:text [ fhir:v "limited concern" ]
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "COVID-19 Knowledge Accelerator Working Group discussion with Brian S. Alper, Ilkka Kunnamo, Joanne Dehnbostel; Performance Bias concern initially suggested by Harold Lehmann" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "Initial adherence to the protocol-assigned anticoagulation dose after randomization was 88.3% in the therapeutic-dose anticoagulation group and 98.3% in the thromboprophylaxis group (Table S3)." ]
         ] [
           fhir:summary [ fhir:v "Definition of Nonadherence of implementation = A performance bias in which the intervention deliverers do not completely adhere to the expected intervention." ]
         ] )
       ] )
     ] [
       fhir:summary [ fhir:v "The influence of awareness of treatment assignment by the treating clinicians on the initaition of organ support (which is the primary outcome) was already addressed as Performance Bias so is not repeated here as a bias in detecting the outcome." ] ;
       fhir:type [
         fhir:text [ fhir:v "Detection Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "no-concern" ] ;
           fhir:display [ fhir:v "no serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Muhammad Afzal" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Detection Bias = A bias due to distortions in how variable values (data) are determined." ]
       ] )
     ] [
       fhir:summary [ fhir:v "Only 19 of 1190 (1.6%) therapeutic group and 6 of 1054 (0.6) prophylactic group were excluded after randomization." ] ;
       fhir:type [
         fhir:text [ fhir:v "Attrition Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "no-concern" ] ;
           fhir:display [ fhir:v "no serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Muhammad Afzal" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Attrition Bias = A bias due to absence of expected participation or data collection after selection for study inclusion." ]
       ] )
     ] [
       fhir:summary [ fhir:v "It is unknown if the results are sensitive to the analytic method, and the stopping criteria were based on statistical significance and not magnitude of effect." ] ;
       fhir:type [
         fhir:text [ fhir:v "Analysis Bias" ]
       ] ;
       fhir:classifier ( [
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
           ] ;
           fhir:version [ fhir:v "6.0.0" ] ;
           fhir:code [ fhir:v "very-serious-concern" ] ;
           fhir:display [ fhir:v "very serious concern" ] ;
           fhir:userSelected [ fhir:v true ]
         ] )
       ] ) ;
       fhir:author ( [
         fhir:display [ fhir:v "Brian S. Alper" ]
       ] [
         fhir:display [ fhir:v "Joanne Dehnbostel" ]
       ] [
         fhir:display [ fhir:v "Muhammad Afzal" ]
       ] [
         fhir:display [ fhir:v "Janice Tufte" ]
       ] ) ;
       fhir:component ( [
         fhir:summary [ fhir:v "Definition of Analysis Bias = A bias related to the analytic process applied to the data." ]
       ] [
         fhir:summary [ fhir:v "A frequentist analysis is not reported so we cannot determine if the results are sensitive to the analytic method" ] ;
         fhir:type [
           fhir:text [ fhir:v "Bias related to selection of the analysis" ]
         ] ;
         fhir:classifier ( [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
             ] ;
             fhir:version [ fhir:v "6.0.0" ] ;
             fhir:code [ fhir:v "very-serious-concern" ] ;
             fhir:display [ fhir:v "very serious concern" ] ;
             fhir:userSelected [ fhir:v true ]
           ] )
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] [
           fhir:display [ fhir:v "Joanne Dehnbostel" ]
         ] [
           fhir:display [ fhir:v "Muhammad Afzal" ]
         ] [
           fhir:display [ fhir:v "Janice Tufte" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "Definition of Bias related to selection of the analysis = An analysis bias due to inappropriate choice of analysis methods before the analysis is applied." ]
         ] [
           fhir:summary [ fhir:v "There was no pre-specified frequentist analysis. There was no posthoc frequentist analysis reported." ]
         ] [
           fhir:summary [ fhir:v "It is uncertain what a frequentist analysis would show and uncertain whether the choice of Bayesian analysis or frequentist analysis has a substantial influence on the results." ]
         ] )
       ] [
         fhir:summary [ fhir:v "The stopping criteria were based on statistical significance and not magnitude of effect." ] ;
         fhir:type [
           fhir:text [ fhir:v "Early trial termination" ]
         ] ;
         fhir:classifier ( [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/certainty-rating"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/certainty-rating>
             ] ;
             fhir:version [ fhir:v "6.0.0" ] ;
             fhir:code [ fhir:v "very-serious-concern" ] ;
             fhir:display [ fhir:v "very serious concern" ] ;
             fhir:userSelected [ fhir:v true ]
           ] )
         ] ) ;
         fhir:author ( [
           fhir:display [ fhir:v "Brian S. Alper" ]
         ] [
           fhir:display [ fhir:v "Joanne Dehnbostel" ]
         ] [
           fhir:display [ fhir:v "Muhammad Afzal" ]
         ] [
           fhir:display [ fhir:v "Janice Tufte" ]
         ] ) ;
         fhir:component ( [
           fhir:summary [ fhir:v "There was no “minimally important difference”. So a 99% probability of having an odds ratio > 1 (even if the magnitude of effect is infinitesimal) was used to decide it was time to stop the trial." ]
         ] )
       ] )
     ] )
  ] [
     fhir:summary [ fhir:v "Results not consistent with critically ill cohort." ] ;
     fhir:type [
       fhir:coding ( [
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/certainty-type"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/certainty-type>
         ] ;
         fhir:version [ fhir:v "6.0.0" ] ;
         fhir:code [ fhir:v "Inconsistency" ] ;
         fhir:display [ fhir:v "Inconsistency" ] ;
         fhir:userSelected [ fhir:v true ]
       ] )
     ] ;
     fhir:author ( [
       fhir:display [ fhir:v "Ilkka Kunnamo" ]
     ] )
  ] ) . # 

