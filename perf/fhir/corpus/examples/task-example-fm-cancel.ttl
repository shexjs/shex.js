       fhir:v "http://happyvalley.com/claim/1500"^^xsd:anyURI ;
       fhir:l <http://happyvalley.com/claim/1500>
     ]
  ] ) ; # 
  fhir:authoredOn [ fhir:v "2018-10-04T08:25:05+10:00"^^xsd:dateTime] ; # 
