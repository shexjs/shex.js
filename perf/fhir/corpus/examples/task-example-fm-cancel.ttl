     ] ;
     fhir:value [ fhir:v "20181012-001" ]
  ] ) ; # 
  fhir:status [ fhir:v "requested"] ; # 
  fhir:intent [ fhir:v "order"] ; # 
  fhir:priority [ fhir:v "stat"] ; # 
  fhir:code [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/financialtaskcode"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/financialtaskcode>
       ] ;
