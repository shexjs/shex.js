     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>\n        <b> Generated Narrative with Details</b>\n      </p>\n    </div>"^^rdf:XMLLiteral ]
  ] ; # 
