@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

# One common use of Group is to report observations on aggregated patient data.
#Typically, in these cases, there won't be must descriptive content 
#about the group - just that some user made a selection. The group will
#be referred to from one or more Observations

<http://hl7.org/fhir/Group/102> a fhir:Group ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "102"] ; # 
  fhir:text [
     fhir:status [ fhir:v "additional" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>Selected Patients</p>\n      <ul>\n        <li>Patient Donald DUCK @ Acme Healthcare, Inc. MR = 654321</li>\n        <li>Patient Donald D DUCK @ Acme Healthcare, Inc. MR = 123456</li>\n        <li>Patient Simon Notsowell @ Acme Healthcare, Inc. MR = 123457, DECEASED</li>\n        <li>Patient Sandy Notsowell @ Acme Healthcare, Inc. MR = 123458, DECEASED</li>\n      </ul>\n    </div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:extension ( [
     fhir:url [
       fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"^^xsd:anyURI ;
       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-wg>
     ] ;
     fhir:value [
       a fhir:Code ;
       fhir:v "fhir"
     ]
  ] ) ; # 
  fhir:publisher [ fhir:v "HL7 International / FHIR Infrastructure"] ; # 
  fhir:contact ( [
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://www.hl7.org/Special/committees/fiwg" ]
     ] )
  ] ) ; # 
  fhir:type [ fhir:v "person"] ; # 
  fhir:membership [ fhir:v "enumerated"] ; # 
  fhir:member ( [
     fhir:entity [
       fhir:l <http://hl7.org/fhir/Patient/pat1> ;
       fhir:reference [ fhir:v "Patient/pat1" ]
     ] ;
     fhir:period [
       fhir:start [ fhir:v "2014-10-08"^^xsd:date ]
     ]
  ] [
     fhir:entity [
       fhir:l <http://hl7.org/fhir/Patient/pat2> ;
       fhir:reference [ fhir:v "Patient/pat2" ]
     ] ;
     fhir:period [
       fhir:start [ fhir:v "2015-04-02"^^xsd:date ]
     ] ;
     fhir:inactive [ fhir:v true ]
  ] [
     fhir:entity [
       fhir:l <http://hl7.org/fhir/Patient/pat3> ;
       fhir:reference [ fhir:v "Patient/pat3" ]
     ] ;
     fhir:period [
       fhir:start [ fhir:v "2015-08-06"^^xsd:date ]
     ]
  ] [
     fhir:entity [
       fhir:l <http://hl7.org/fhir/Patient/pat4> ;
       fhir:reference [ fhir:v "Patient/pat4" ]
     ] ;
     fhir:period [
       fhir:start [ fhir:v "2015-08-06"^^xsd:date ]
     ]
  ] ) . # 

<http://hl7.org/fhir/Patient/pat1> a fhir:Patient .

<http://hl7.org/fhir/Patient/pat2> a fhir:Patient .

<http://hl7.org/fhir/Patient/pat3> a fhir:Patient .

<http://hl7.org/fhir/Patient/pat4> a fhir:Patient .

