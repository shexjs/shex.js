       ] ;
       fhir:code [ fhir:v "DC" ] ;
       fhir:display [ fhir:v "District of Columbia" ]
     ] )
  ] ) ; # this record is active
  fhir:name [ fhir:v "Washington, DC metro area"] ; # 
  fhir:form [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/location-physical-type"^^xsd:anyURI ;
