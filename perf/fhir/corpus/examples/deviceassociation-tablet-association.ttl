@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/DeviceAssociation/tablet-association> a fhir:DeviceAssociation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "tablet-association"] ; # 
  fhir:contained ( [
     a fhir:Practitioner ;
     fhir:id [ fhir:v "example-practitioner" ] ;
     fhir:name ( [
       fhir:family [ fhir:v "Nguyen" ] ;
       fhir:given ( [ fhir:v "Alex" ] )
     ] )
  ] [
     a fhir:Device ;
     fhir:id [ fhir:v "tablet-device" ] ;
     fhir:status [ fhir:v "active" ] ;
     fhir:name ( [
       fhir:value [ fhir:v "handPad Pro" ] ;
       fhir:type [
         fhir:coding ( [
           fhir:code [ fhir:v "model-name" ]
         ] )
       ]
     ] ) ;
     fhir:type ( [
       a sct:464572002 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "464572002" ] ;
         fhir:display [ fhir:v "Palmtop computer" ]
       ] )
     ] )
  ] ) ; # 
  fhir:device [
     fhir:l <#tablet-device> ;
     fhir:reference [ fhir:v "#tablet-device" ]
  ] ; # 
  fhir:relationship [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://hl7.org/fhir/deviceassociation-relationship"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/deviceassociation-relationship>
       ] ;
       fhir:code [ fhir:v "assigned-to" ] ;
       fhir:display [ fhir:v "Assigned To" ]
     ] )
  ] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:relationshipStatus [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://hl7.org/fhir/deviceassociation-relationship-status"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/deviceassociation-relationship-status>
       ] ;
       fhir:code [ fhir:v "active" ] ;
       fhir:display [ fhir:v "Active" ]
     ] )
  ] ; # 
  fhir:subject [
     fhir:l <#example-practitioner> ;
     fhir:reference [ fhir:v "#example-practitioner" ]
  ] ; # 
  fhir:period [
     fhir:start [ fhir:v "2023-06-01"^^xsd:date ]
  ] . # 

