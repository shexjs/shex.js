         fhir:l <http://hl7.org/fhir/sid/ndc>
       ] ;
       fhir:code [ fhir:v "0169-7501-11" ] ;
       fhir:display [ fhir:v "NOVOLOG, 1 VIAL, GLASS in 1 CARTON (0169-7501-11) > 10 mL in 1 VIAL, GLASS (package)" ]
     ] ) ;
     fhir:text [ fhir:v "Novolog 100u/ml" ]
  ] ; # 
  fhir:marketingAuthorizationHolder [
     fhir:l <#mmanu> ;
     fhir:reference [ fhir:v "#mmanu" ]
  ] ; # 
  fhir:doseForm [
     a sct:385219001 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
         fhir:l <http://snomed.info/sct>
       ] ;
       fhir:code [ fhir:v "385219001" ] ;
       fhir:display [ fhir:v "Solution for injection" ]
     ] )
  ] ; # 
  fhir:ingredient ( [
     fhir:item [
       fhir:concept [
         a sct:325072002 ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
             fhir:l <http://snomed.info/sct>
           ] ;
           fhir:code [ fhir:v "325072002" ] ;
           fhir:display [ fhir:v "Insulin Aspart (substance)" ]
         ] )
       ]
     ] ;
     fhir:strength [
       a fhir:Ratio ;
       fhir:numerator [
         fhir:value [ fhir:v "100"^^xsd:decimal ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "U" ]
       ] ;
       fhir:denominator [
         fhir:value [ fhir:v "1"^^xsd:decimal ] ;
         fhir:system [
           fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ;
           fhir:l <http://unitsofmeasure.org>
         ] ;
         fhir:code [ fhir:v "mL" ]
       ]
     ]
  ] ) ; # 
  fhir:instance [
     fhir:lotNumber [ fhir:v "12345" ] ;
     fhir:expirationDate [ fhir:v "2019-10-31"^^xsd:date ]
  ] . # 

