# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/Medication/med0307> a fhir:Medication ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "med0307"] ; # 
  fhir:contained ( [
     a fhir:Organization ;
     fhir:id [ fhir:v "mmanu" ] ;
