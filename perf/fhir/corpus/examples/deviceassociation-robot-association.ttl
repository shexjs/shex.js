@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sct: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.org/fhir/DeviceAssociation/robot-association> a fhir:DeviceAssociation ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "robot-association"] ; # 
  fhir:contained ( [
     a fhir:Patient ;
     fhir:id [ fhir:v "example-patient" ] ;
     fhir:name ( [
       fhir:family [ fhir:v "Doe" ] ;
       fhir:given ( [ fhir:v "John" ] )
     ] )
  ] [
     a fhir:Practitioner ;
     fhir:id [ fhir:v "example-practitioner" ] ;
     fhir:name ( [
       fhir:family [ fhir:v "Nguyen" ] ;
       fhir:given ( [ fhir:v "Alex" ] )
     ] )
  ] [
     a fhir:Device ;
     fhir:id [ fhir:v "surgical-robot" ] ;
     fhir:status [ fhir:v "active" ] ;
     fhir:name ( [
       fhir:value [ fhir:v "Da Vinci Xi" ] ;
       fhir:type [
         fhir:coding ( [
           fhir:code [ fhir:v "model-name" ]
         ] )
       ]
     ] ) ;
     fhir:type ( [
       a sct:466893009 ;
       fhir:coding ( [
         fhir:system [
           fhir:v "http://snomed.info/sct"^^xsd:anyURI ;
           fhir:l <http://snomed.info/sct>
         ] ;
         fhir:code [ fhir:v "466893009" ] ;
         fhir:display [ fhir:v "Robotic surgical system" ]
       ] )
     ] )
  ] ) ; # 
  fhir:device [
     fhir:l <#surgical-robot> ;
     fhir:reference [ fhir:v "#surgical-robot" ]
  ] ; # 
  fhir:relationship [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://hl7.org/fhir/deviceassociation-relationship"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/deviceassociation-relationship>
       ] ;
       fhir:code [ fhir:v "used-by" ] ;
       fhir:display [ fhir:v "Used By" ]
     ] )
  ] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:relationshipStatus [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://hl7.org/fhir/deviceassociation-relationship-status"^^xsd:anyURI ;
         fhir:l <http://hl7.org/fhir/deviceassociation-relationship-status>
       ] ;
       fhir:code [ fhir:v "ended" ] ;
       fhir:display [ fhir:v "Ended" ]
     ] )
  ] ; # 
  fhir:subject [
     fhir:l <#example-patient> ;
     fhir:reference [ fhir:v "#example-patient" ]
  ] ; # 
  fhir:focus [
     fhir:l <#example-practitioner> ;
     fhir:reference [ fhir:v "#example-practitioner" ]
  ] ; # 
  fhir:period [
     fhir:start [ fhir:v "2025-07-01T08:00:00Z"^^xsd:dateTime ] ;
     fhir:end [ fhir:v "2025-07-01T12:00:00Z"^^xsd:dateTime ]
  ] . # 

