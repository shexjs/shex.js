         fhir:display [ fhir:v "Non-invasive blood pressure monitor" ]
       ] )
     ] )
  ] [
     a fhir:BodyStructure ;
     fhir:id [ fhir:v "left-arm-structure" ] ;
     fhir:includedStructure ( [
       fhir:structure [
