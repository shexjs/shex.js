<http://hl7.org/fhir/Consent/consent-example-notLabs> a fhir:Consent ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "consent-example-notLabs"] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n      <p>The default policy is one of implied consent for the provision of care, so these scenarios all deal with withdrawal or withholding consent for that purpose.</p>\n      <p>Withhold or withdraw consent for disclosure of records related to specific domain (e.g. DI, LAB, etc.)</p>\n      <p>Patient \"Donald D DUCK\" wishes to withhold disclosure of all of her lab results to any provider.</p>\n    </div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:category ( [
     a loinc:59284-0 ;
     fhir:coding ( [
       fhir:system [
         fhir:v "http://loinc.org"^^xsd:anyURI ;
         fhir:l <http://loinc.org>
       ] ;
       fhir:code [ fhir:v "59284-0" ]
     ] )
  ] ) ; # 
  fhir:subject [
     fhir:l <http://hl7.org/fhir/Patient/f002> ;
     fhir:reference [ fhir:v "Patient/f002" ] ;
     fhir:display [ fhir:v "P. van de Heuvel" ]
  ] ; # 
  fhir:date [ fhir:v "2015-11-18"^^xsd:date] ; # 
  fhir:manager ( [
     fhir:l <http://hl7.org/fhir/Practitioner/f007> ;
     fhir:reference [ fhir:v "Practitioner/f007" ]
  ] ) ; # 
  fhir:controller ( [
     fhir:l <http://hl7.org/fhir/Organization/f001> ;
     fhir:reference [ fhir:v "Organization/f001" ]
  ] ) ; # 
  fhir:sourceAttachment ( [
     fhir:title [ fhir:v "The terms of the consent in lawyer speak." ]
  ] ) ; # the text terms of the consent in lawyer speak, likely use url pointer to common text
  fhir:regulatoryBasis ( [
     fhir:coding ( [
       fhir:system [
         fhir:v "http://terminology.hl7.org/CodeSystem/v3-ActCode"^^xsd:anyURI ;
         fhir:l <http://terminology.hl7.org/CodeSystem/v3-ActCode>
       ] ;
       fhir:code [ fhir:v "INFA" ]
     ] )
  ] ) ; # this is opt-in - e.g. everything approved unless otherwise stated
  fhir:decision [ fhir:v "permit"] ; # 
