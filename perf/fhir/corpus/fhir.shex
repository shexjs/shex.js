    			@<Integer>  OR 
    			@<Boolean>  OR 
    			@<DateTime>  OR 
    			@<Decimal>  ; 
    fhir:subProperty @<OneOrMore_ValueSet.expansion.contains.property.subProperty>?; 
}  

# SubProperty value for the concept
<ValueSet.expansion.contains.property.subProperty> EXTENDS @<BackboneElement> CLOSED {   
    fhir:code @<Code>; 
