    			@<Date>  OR 
    			@<DateTime>  OR 
    			@<Time>  OR 
    			@<String>  OR 
    			@<Uri>  OR 
    			@<Attachment>  OR 
    			@<Coding>  OR 
    			@<SimpleQuantity>  OR 
    			(@<Reference>  AND {fhir:l @<Resource> })  ; 
    fhir:item @<OneOrMore_QuestionnaireResponse.item>?; 
}  

