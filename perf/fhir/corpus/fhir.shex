    fhir:value @<Quantity>  OR 
    			@<CodeableConcept>  OR 
    			@<String>  OR 
    			@<Boolean>  OR 
    			@<Integer>  OR 
    			@<Range>  OR 
    			@<Attachment>  ; 
}  

# Material added to a container device
<Device.additive> EXTENDS @<BackboneElement> CLOSED {   
    fhir:type @<CodeableReference>; 
    fhir:quantity @<Quantity>?; 
}  

