    fhir:numberOfStudies @<UnsignedInt>?; 
    fhir:numberOfParticipants @<UnsignedInt>?; 
    fhir:knownDataCount @<UnsignedInt>?; 
    fhir:numberAnalyzed @<UnsignedInt>?; 
}  

