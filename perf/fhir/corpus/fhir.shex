<SubstanceDefinition.polymer.repeat.repeatUnit.degreeOfPolymerisation> EXTENDS @<BackboneElement> CLOSED {   
    fhir:type @<CodeableConcept>?; 
    fhir:average @<Integer>?; 
    fhir:low @<Integer>?; 
    fhir:high @<Integer>?; 
}  

# Data items specific to proteins
<SubstanceDefinition.protein> EXTENDS @<BackboneElement> CLOSED {   
    fhir:sequenceType @<CodeableConcept>?; 
    fhir:numberOfSubunits @<Integer>?; 
    fhir:disulfideLinkage @<OneOrMore_String>?; 
    fhir:subunit @<OneOrMore_SubstanceDefinition.protein.subunit>?; 
    fhir:gene @<OneOrMore_SubstanceDefinition.nucleicAcid.gene>?; 
    fhir:modificationType @<CodeableConcept>?; 
}  

# Each subunit constituting the protein. A subunit is a linear sequence of amino acids linked through peptide bonds. Used when the finished protein is a complex of multiple sequences (not for domains within a single sequence). Subunits are listed in order of decreasing length; ties resolved by decreasing molecular weight; identical sequences are repeated
<SubstanceDefinition.protein.subunit> EXTENDS @<BackboneElement> CLOSED {   
    fhir:subunit @<Integer>?; 
    fhir:sequence @<String>?; 
    fhir:length @<Integer>?; 
    fhir:sequenceAttachment @<Attachment>?; 
    fhir:nTerminalModification @<CodeableReference>?; 
    fhir:cTerminalModification @<CodeableReference>?; 
}  

# What task is acting on
<Task.focus> EXTENDS @<BackboneElement> CLOSED {   
    fhir:value (@<Reference>  AND {fhir:l @<Resource> })  OR 
    			(@<Canonical>  AND {fhir:l @<CanonicalResource> })  ; 
}  

# Who or what performed the task
<Task.performer> EXTENDS @<BackboneElement> CLOSED {   
    fhir:function @<CodeableConcept>?; 
    fhir:actor @<Reference> AND {fhir:l 
    			@<CareTeam> OR 
    			@<Device> OR 
    			@<Group> OR 
    			@<Organization> OR 
    			@<Patient> OR 
    			@<Practitioner> OR 
    			@<PractitionerRole> OR 
    			@<RelatedPerson> ? }; 
}  

