    fhir:dependsOn @<OneOrMore_ImplementationGuide.dependsOn>?; 
    fhir:global @<OneOrMore_ImplementationGuide.global>?; 
    fhir:definition @<ImplementationGuide.definition>?; 
    fhir:manifest @<ImplementationGuide.manifest>?; 
}  
