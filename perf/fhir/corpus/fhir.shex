    fhir:onBehalfOf @<Reference> AND {fhir:l 
    			@<Device> OR 
    			@<Organization> OR 
    			@<Patient> OR 
    			@<Practitioner> OR 
    			@<PractitionerRole> OR 
    			@<RelatedPerson> ? }?; 
    fhir:targetFormat @<Code> AND
    	{fhir:v @fhirvs:mimetypes}?; 
    fhir:sigFormat @<Code> AND
    	{fhir:v @fhirvs:mimetypes}?; 
    fhir:data @<Base64Binary>?; 
}  
