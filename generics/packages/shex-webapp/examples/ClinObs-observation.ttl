# Observation
PREFIX : <http://hl7.org/fhir/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX loinc: <http://loinc.org/rdf#>
BASE <http://hl7.example/>

# What was measured, when, and about whom.  The patient is in the next
# document: one graph, written as two files, the way a record usually
# arrives -- an observation from an instrument, a patient from a registry.
<Obs1>
  :status            "final" ;
  :code              loinc:29463-7 ;        # Body weight
  :effectiveDateTime "2026-08-13T09:41:00Z"^^xsd:dateTime ;
  :subject           <Patient2> ;
  :performer         <Practitioner7> ;
  :valueQuantity     [
    :value  81.2 ;
    :unit   "kg" ;
    :system <http://unitsofmeasure.org> ;
    :code   "kg"
  ] .

<Practitioner7>
  :name "Dr. Alice Chen" .
