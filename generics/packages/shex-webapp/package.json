{
  "name": "@shexjs/webapp",
  "version": "1.0.0-alpha.30",
  "files": [
    "bin",
    "doc",
    "examples",
    "lib",
    "src",
    "shex-webapp.js",
    "shex-webapp.d.ts"
  ],
  "description": "Shape Expressions command line interface",
  "author": {
    "name": "Eric Prud'hommeaux",
    "email": "eric@w3.org",
    "url": "http://www.w3.org/People/Eric/"
  },
  "keywords": [
    "shex",
    "shape expressions",
    "rdf",
    "query",
    "parser"
  ],
  "license": "MIT",
  "main": "./shex-webapp.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@shexjs/editor-services": "^1.0.0-alpha.30",
    "@shexjs/eval-simple-1err": "^1.0.0-alpha.30",
    "@shexjs/eval-threaded-nerr": "^1.0.0-alpha.30",
    "@shexjs/eval-validator-api": "^1.0.0-alpha.30",
    "@shexjs/loader": "^1.0.0-alpha.30",
    "@shexjs/neighborhood-api": "^1.0.0-alpha.30",
    "@shexjs/neighborhood-rdfjs": "^1.0.0-alpha.30",
    "@shexjs/neighborhood-sparql": "^1.0.0-alpha.30",
    "@shexjs/neighborhood-wikibase": "^1.0.0-alpha.30",
    "@shexjs/parser": "^1.0.0-alpha.30",
    "@shexjs/term": "^1.0.0-alpha.28",
    "@shexjs/util": "^1.0.0-alpha.30",
    "@shexjs/validator": "^1.0.0-alpha.30",
    "@shexjs/visitor": "^1.0.0-alpha.30",
    "@shexjs/writer": "^1.0.0-alpha.30",
    "command-line-args": "^5.0.2",
    "command-line-usage": "^7.0.3",
    "dctap": "^0.0.6",
    "hierarchy-closure": "^1.2.2",
    "jquery": "^3.7.1",
    "js-yaml": "^4.1.0",
    "n3": "^1.20.4",
    "shape-map": "^1.0.0"
  },
  "scripts": {
    "make": "(cd test/ && make test)",
    "test": "mocha -C -R dot",
    "webpack": "webpack --config webpack.config.js --mode production",
    "webpack-analyzer": "webpack --config webpack.config.js --mode production --profile --json > ./doc/webpacks/shex-webapp-stats.json && webpack-bundle-analyzer ./doc/webpacks/shex-webapp-stats.json",
    "webpack-jquery-components": "webpack --config webpack-jquery-components.config.js --mode development",
    "webpack-monitor": "WEBPACK_MONITOR=true webpack --config webpack.config.js --mode production",
    "webpack-n3js": "webpack --config webpack-n3js.config.js --mode development",
    "build": "tsc && tsc -p tsconfig.app.json",
    "prepublishOnly": "npm run webpack-n3js && npm run webpack"
  },
  "devDependencies": {
    "jquery": "^3.7.1",
    "jquery-contextmenu": "^2.9.2",
    "jquery-ui": "^1.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shexjs/shex.js.git"
  },
  "bugs": {
    "url": "https://github.com/shexjs/shex.js/issues"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "bin": {
    "shex-serve": "bin/shex-serve"
  }
}
