  "main": "./lib/shex-extension-wasi.js",
  "scripts": {
    "test": "cd ../.. && mocha -C -R dot packages/extension-wasi/test/*test.js",
    "gen-tests": "node tools/gen-tests.js",
    "build": "node tools/gen-prelude.js && tsc",
    "webpack": "webpack --config webpack.config.js --mode production",
    "prepublishOnly": "npm run webpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shexSpec/shex.js.git",
    "directory": "packages/extension-wasi"
  },
