# GENERATED by `node tools/yamlld-to-nested-turtle.js doc/tests-manifest-ld.yaml`, with the
# checkout's file:// base rewritten to IRIs relative to this file, so the same references
# resolve wherever doc/ is served from.  The graph the sketch's stacked contexts produce --
# the point being to see it: each vocabulary's attributes hang off one <prefix>:parms arc as
# a blank node, its plugin among them.  @shexjs/manifest reads this back into the same
# entries the YAML gives (packages/shex-manifest/test/Manifest-test.js checks), so validate
# --turtle-manifest and the web app's ?manifestURL= take it too.  Regenerate after editing
# the YAML or a context.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX shex: <http://www.w3.org/ns/shex#>
PREFIX shexMan: <http://www.w3.org/ns/shex-manifest#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX shexjs: <https://shex.js.org/doc/manifest-context.jsonld#>
PREFIX nsp: <http://shex.js.org/neighborhoods/Sparql/#>
PREFIX nwb: <http://shex.js.org/neighborhoods/Wikibase/#>
PREFIX map: <http://shex.io/extensions/Map/#>
PREFIX rdc: <http://shex.io/extensions/Reduce/#>
PREFIX ssp: <http://shex.io/extensions/SHACL-SPARQL/>

_:b0 shexMan:entries (_:b1 _:b2 _:b4 _:b6 _:b9 _:b11 _:b13
  ).
<http://shex.js.org/neighborhoods/Sparql/#> shexjs:manifestContext <../packages/neighborhood-sparql/manifest-context.jsonld>.
<http://shex.js.org/neighborhoods/Wikibase/#> shexjs:manifestContext <../packages/neighborhood-wikibase/manifest-context.jsonld>.
<http://shex.io/extensions/Map/#> shexjs:manifestContext <https://shexspec.github.io/extensions/Map/manifest-context.jsonld>.
<http://shex.io/extensions/Reduce/#> shexjs:manifestContext <https://shexspec.github.io/extensions/Reduce/manifest-context.jsonld>.
<http://shex.io/extensions/SHACL-SPARQL/> shexjs:manifestContext <https://shexspec.github.io/extensions/SHACL-SPARQL/manifest-context.jsonld>.
_:b1 rdfs:comment "Everything core: no neighborhood, no extension, no plugin -- this is what an entry looks like when it needs nothing this sketch is about.";
  shex:status "conformant";
  shexMan:data "PREFIX : <http://hl7.org/fhir/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\n<Obs1> :subject <Patient2> .\n";
  shexMan:dataLabel "the least an Observation can be";
  shexMan:queryMap "<Obs1>@START\n";
  shexMan:schema <../packages/shex-webapp/examples/ClinObs.shex>;
  shexMan:schemaLabel "clinical observation".
_:b2 rdfs:comment "Douglas Adams, validated by asking query.wikidata.org for each neighborhood as the walk needs it.  `slurp` here is NOT in the current examples manifest -- it is the webapp's cross-neighborhood \"record what was fetched, as replayable Turtle\" checkbox (see doc/manifest-vocabulary.md), added here to show it belongs in the CORE context, not sparql's, because...";
  shex:status "conformant";
  shexMan:dataLabel "Q42 from the query service";
  shexMan:queryMap "<http://www.wikidata.org/entity/Q42>@START\n";
  shexMan:schema <../packages/shex-webapp/examples/wikidata-person.shex>;
  shexMan:schemaLabel "Wikidata person";
  nsp:parms [
    shexjs:plugin <../packages/neighborhood-sparql/lib/neighborhood-sparql.js>;
    nsp:endpoint <https://query.wikidata.org/sparql>
  ];
  shexjs:dataBase <http://www.wikidata.org/entity/>;
  shexjs:neighborhood "sparql";
  shexjs:slurp true.
_:b4 rdfs:comment "...it means the same thing here, over an entirely different neighborhood: a viewer of this manifest that doesn't understand `nwb:*` at all can still recognize `slurp` and `dataBase` as attributes it already knows from the sparql entry above.  `nwb:sitematrix` and `nsp:endpoint`, by contrast, could not be swapped between these two entries -- which is exactly why each is namespaced to the neighborhood it configures -- and why each sits in its own parms mapping: `sitematrix` written bare beside `nsp:parms` would be undefined, not silently sparql's.";
  shex:status "conformant";
  shexMan:data <../packages/shex-webapp/examples/wikidata-Q42.json>;
  shexMan:dataLabel "Q42 from a downloaded page";
  shexMan:queryMap "<http://www.wikidata.org/entity/Q42>@START\n";
  shexMan:schema <../packages/shex-webapp/examples/wikidata-person.shex>;
  shexMan:schemaLabel "Wikidata person";
  shexjs:dataBase <http://www.wikidata.org/entity/>;
  shexjs:neighborhood "wikibase";
  shexjs:slurp true;
  nwb:parms [
    shexjs:plugin <../packages/neighborhood-wikibase/lib/neighborhood-wikibase.js>;
    nwb:sitematrix <../packages/shex-webapp/examples/wikidata-sitematrix.json>
  ].
_:b6 shex:status "conformant";
  shexMan:data <../packages/extension-map/examples/BPfhir-instance.ttl>;
  shexMan:dataLabel "simple";
  shexMan:queryMap "<tag:BPfhir123>@START";
  shexMan:schema <../packages/extension-map/examples/BPfhir-schema.shex>;
  shexMan:schemaLabel "BP";
  map:parms [
    map:expectedBindings <../packages/extension-map/examples/BP-simple-bindings.json>;
    map:expectedOutputData <../packages/extension-map/examples/BP-simple-out.ttl>;
    map:outputSchema <../packages/extension-map/examples/BPdam-schema.shex>;
    map:outputShapeMap "<tag:b0>@<BPunitsDAM>";
    shexjs:plugin <../packages/extension-map/doc/ShExMapPlugin.js>;
    map:staticVars [
      <http://abc.example/someConstant> "\"123-456\""
    ]
  ].
_:b9 rdfs:comment "threadedOnly marks an entry ThreadedMaterializer-test alone exercises -- extension-map's own concern, hence inside map:parms rather than a bare flag any extension might reuse unrelated.";
  shex:status "conformant";
  shexMan:data <../packages/extension-map/examples/contact-Ann.ttl>;
  shexMan:dataLabel "Ann-phone-mbox";
  shexMan:queryMap "<PersonX>@<Person>";
  shexMan:schema <../packages/extension-map/examples/contact-schema.shex>;
  shexMan:schemaLabel "splits";
  map:parms [
    map:expectedBindings <../packages/extension-map/examples/splits-bindings.json>;
    map:expectedOutputData <../packages/extension-map/examples/splits-out.ttl>;
    map:outputSchema <../packages/extension-map/examples/card-schema-phone-mbox.shex>;
    map:outputShapeMap "<tag:card1>@<Card>";
    map:threadedOnly true;
    shexjs:plugin <../packages/extension-map/doc/ShExMapPlugin.js>
  ].
_:b11 rdfs:comment "overlayURL is ShExReduce's: the overlay supplies the semantic actions the schema is reduced with, so it sits in rdc:parms beside the plugin that implements the vocabulary.  Read flat, the entry still has overlayURL beside schemaURL, which is where manifest-runner.js's loadEntry() and the web app look for it.";
  shex:status "conformant";
  shexMan:data <../packages/extension-reduce/examples/calc/expr1.ttl>;
  shexMan:dataLabel "(1 + 2) * 3";
  shexMan:queryMap "<http://a.example/expr1#e1>@<http://a.example/calc#Expr>";
  shexMan:schema <../packages/extension-reduce/examples/calc/calc.shex>;
  shexMan:schemaLabel "calc, actions in an overlay";
  rdc:parms [
    shexjs:plugin <../packages/extension-reduce/doc/ShExReducePlugin.js>;
    rdc:overlay <../packages/extension-reduce/examples/calc/calc-actions.ttl>
  ].
_:b13 rdfs:comment "Every attribute here is core; the ssp: scope is reserved but empty (see its manifest-context.jsonld), so its mapping carries only the plugin -- nothing about this extension needs a manifest attribute of its own today.";
  shex:status "conformant";
  shexMan:data "PREFIX : <http://a.example/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n:conf :name \"ShEx Symposium\" ;\n  :start \"2026-10-05\"^^xsd:date ; :end \"2026-10-07\"^^xsd:date .\n";
  shexMan:dataLabel "a conference";
  shexMan:queryMap "<http://a.example/conf>@<http://a.example/Event>\n";
  shexMan:schema <../packages/extension-shacl-sparql/examples/events.shex>;
  shexMan:schemaLabel "Events end after they start";
  ssp:parms [
    shexjs:plugin <../packages/extension-shacl-sparql/doc/ShExShaclSparqlPlugin.js>
  ].
