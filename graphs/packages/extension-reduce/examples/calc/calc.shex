# An expression language, as a ShEx schema.  There is nothing about ASTs in
# here: this is the grammar, and it is as useful to a validator, a form
# generator or a documentation tool as it is to the compiler next door in
# calc-actions.ttl.
PREFIX : <http://a.example/calc#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
BASE <http://a.example/calc>

<#Expr> @<#BinOp> OR @<#Num>

<#BinOp> {
  a       [:Add :Sub :Mul :Div] ;
  :left   @<#Expr> ;
  :right  @<#Expr>
}

<#Num> {
  a       [:Num] ;
  :value  xsd:integer
}
