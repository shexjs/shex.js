# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules
EGP/
da-web/
.emacs.desktop*
.dependabot/
.idea/
.vscode/

*-stats.json

# webpack bundles: built locally with `npm run webpacks-all`, or on push to
# main by .github/workflows/webapps-site.yml which publishes them (with the
# webapp pages) to the `gh-pages` branch; fetch prebuilt ones with
# tools/sync-webpacks.sh.
# (jquery-components.* and its hashed png/font assets stay committed: they
# were built in 2023 against jquery-ui 1.12; rebuilding against current
# jquery-ui changes the dialog markup the apps and tests rely on.)
packages/shex-webapp/doc/webpacks/n3js*.js
packages/shex-webapp/doc/webpacks/shex-webapp*.js
packages/shex-webapp/doc/webpacks/*.LICENSE.txt
packages/extension-map/doc/webpacks/
packages/extension-reduce/doc/webpacks/
packages/extension-wasi/doc/webpacks/

.coveralls.yml
.nyc_output/


# perf corpora: fetched with perf/fhir/fetch.sh, never committed
perf/*/corpus/

# editor droppings
*~
\#*\#

# TypeScript source maps: built beside lib/*.js, read by nothing in the repository
packages/*/lib/*.map

# Compiled JavaScript: lib/*.js is built from src/ (and the .jison grammars) by
# `npm run compile` / the `prepare` script -- on npm install, npm ci and before
# publish -- so CI builds it fresh (which is what catches a src change that
# stops compiling; plan.md B3).  The .jison, .wat and .wasm beside it are
# sources, not output, and stay tracked; so do shex-cli's three hand-written
# lib .js, which have no src/ counterpart.
packages/*/lib/*.js
!packages/shex-cli/lib/ExitCode.js
!packages/shex-cli/lib/ProgressLoadController.js
!packages/shex-cli/lib/ShExDebugRepl.js
