{
    "compilerOptions": {
        "forceConsistentCasingInFileNames": true,
        "module": "node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "outDir": "./lib",
        "rootDir": "./src",
        "target": "es6",
        "skipLibCheck": true,
        "strict": true,
        "noUnusedParameters": true,
        "lib": [
            "ES2021",
            "DOM"
        ],
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}
