PREFIX : <http://hl7.org/fhir/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
BASE <http://schema.example/>
PREFIX sx: <http://www.w3.org/ns/shex#>

# ShExR: the schema in ClinObs.shex, as RDF.  Generated from
# ClinObs.json; the three say the same thing (browser-test checks).

[]
  a sx:Schema ;
  sx:start <ObservationShape> ;
  sx:shapes (
    <ObservationShape>
    <QuantityShape>
    <PractitionerShape>
    <PatientShape>
    <IdentifierShape>
 ) .

<ObservationShape>
  a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
    sx:expression [
      a sx:EachOf ;
      sx:expressions (
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :status ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:values (
              "preliminary"
              "final"
              "amended"
            )
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :code ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:nodeKind sx:iri
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :effectiveDateTime ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:dateTime
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :valueQuantity ;
          sx:valueExpr <QuantityShape>
        ]
        [
          a sx:TripleConstraint ;
          sx:max -1 ;
          sx:min 0 ;
          sx:predicate :performer ;
          sx:valueExpr <PractitionerShape>
        ]
        [
          a sx:TripleConstraint ;
          sx:predicate :subject ;
          sx:valueExpr <PatientShape>
        ]
      )
    ]
  ] .

<QuantityShape>
  a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
    sx:expression [
      a sx:EachOf ;
      sx:expressions (
        [
          a sx:TripleConstraint ;
          sx:predicate :value ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:decimal
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:predicate :unit ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:string
          ]
        ]
        [
          a sx:EachOf ;
          sx:max 1 ;
          sx:min 0 ;
          sx:expressions (
            [
              a sx:TripleConstraint ;
              sx:predicate :code ;
              sx:valueExpr [
                a sx:NodeConstraint ;
                sx:datatype xsd:string
              ]
            ]
            [
              a sx:TripleConstraint ;
              sx:max 1 ;
              sx:min 0 ;
              sx:predicate :system ;
              sx:valueExpr [
                a sx:NodeConstraint ;
                sx:nodeKind sx:iri
              ]
            ]
          )
        ]
      )
    ]
  ] .

<PractitionerShape>
  a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
    sx:expression [
      a sx:TripleConstraint ;
      sx:max -1 ;
      sx:min 1 ;
      sx:predicate :name ;
      sx:valueExpr [
        a sx:NodeConstraint ;
        sx:datatype xsd:string
      ]
    ]
  ] .

<PatientShape>
  a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
    sx:expression [
      a sx:EachOf ;
      sx:expressions (
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :active ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:boolean
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max -1 ;
          sx:min 0 ;
          sx:predicate :name ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:string
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :gender ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:values (
              "male"
              "female"
              "other"
              "unknown"
            )
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max 1 ;
          sx:min 0 ;
          sx:predicate :birthdate ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:date
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:max -1 ;
          sx:min 0 ;
          sx:predicate :identifier ;
          sx:valueExpr <IdentifierShape>
        ]
      )
    ]
  ] .

<IdentifierShape>
  a sx:ShapeDecl ;
  sx:shapeExpr [
    a sx:Shape ;
    sx:expression [
      a sx:EachOf ;
      sx:expressions (
        [
          a sx:TripleConstraint ;
          sx:predicate :system ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:nodeKind sx:iri
          ]
        ]
        [
          a sx:TripleConstraint ;
          sx:predicate :value ;
          sx:valueExpr [
            a sx:NodeConstraint ;
            sx:datatype xsd:string
          ]
        ]
      )
    ]
  ] .
