{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo", // tsc -b (npm run build/watch)
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "outDir": "./lib",
        "rootDir": "./src",
        "target": "es2020",
        "sourceMap": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedParameters": true,
        "lib": [
            "ES2021.String",
            "DOM"
        ]
    },
    "exclude": [
        "node_modules",
        "src/plugin"
    ]
}
